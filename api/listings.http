@host = http://localhost:5154
@email = lesson7@example.com
@password = ChangeThisPassword2026!
@refreshToken = paste-refresh-token-from-auth-response
@listingId = 1

### Регистрация пользователя
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Войти (сохраните token из ответа как @token)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Текущий пользователь
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Обновить пару токенов (refresh token ротируется после использования)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Сменить пароль
POST {{host}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "{{password}}",
  "newPassword": "NewChangeThisPassword2026!"
}

### Выйти и отозвать refresh token
POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
 
### Список
GET {{host}}/api/listings

### Мои объявления (нужен JWT)
GET {{host}}/api/listings/mine
Authorization: Bearer {{token}}
 
### Фильтр по району и цене
GET {{host}}/api/listings?district=Чиланзар&maxPrice=50000
 
### Одно объявление
GET {{host}}/api/listings/1
 
### Несуществующее — ожидаем 404
GET {{host}}/api/listings/999
 
### Создать — требуется JWT владельца
POST {{host}}/api/listings
Authorization: Bearer {{token}}
Content-Type: application/json
 
{
  "title": "3-комн. в Юнусабаде",
  "price": 62000,
  "districtId": 2,
  "rooms": 3,
  "address": "квартал 4, дом 7"
}
 
### Без токена ожидаем 401
POST {{host}}/api/listings
Content-Type: application/json
 
{ "title": "Анонимное объявление", "price": 30000, "districtId": 1, "rooms": 2 }
 
### Заменить своё объявление — ожидаем 204
# Подставьте id объявления, которое создал этот пользователь.
PUT {{host}}/api/listings/{{listingId}}
Authorization: Bearer {{token}}
Content-Type: application/json
 
{ "title": "2-комн. рядом с метро (цена снижена)", "price": 45000, "districtId": 1, "rooms": 2, "address": "ул. Мукими, 12" }
 
### Удалить своё объявление — ожидаем 204; чужое или старое без владельца даст 404
DELETE {{host}}/api/listings/{{listingId}}
Authorization: Bearer {{token}}

### Администратор может удалить любое объявление
DELETE {{host}}/api/admin/listings/{{listingId}}
Authorization: Bearer {{adminToken}}